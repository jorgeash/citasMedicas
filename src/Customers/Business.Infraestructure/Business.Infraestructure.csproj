<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.10" />
    <!-- Resiliencia estandar: reintentos con backoff + circuit breaker para el consumo
         del microservicio de Addresses. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Business.Core\Business.Core.csproj" />
    <!-- Monorepo: la libreria REST se referencia como proyecto, sin publicar el .nupkg -->
    <ProjectReference Include="..\..\NugetPackage_Rest\NugetPackage_Rest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Business.Tests" PublicKey="" />
  </ItemGroup>

</Project>