{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BillingDB": "Server=(localdb)\\mssqllocaldb;Database=BillingDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Services": {
    "Scheduling": {
      "BaseUrl": "http://localhost:52095"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Pasarela": {
    "BaseUrl": "https://api.pasarela.example",
    "ClientId": "billing-demo",
    "ClientSecret": "",
    "MaxReintentos": 2
  },
  "RestSettings": {
    "EnableRequestLogs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
