{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClinicaDB": "Server=(localdb)\\mssqllocaldb;Database=ClinicaDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Downstream": {
    "CitasBaseUrl": "http://localhost:5003",
    "PagosBaseUrl": "http://localhost:5002",
    "ReportesBaseUrl": "http://localhost:5004"
  },
  "Pasarela": {
    "BaseUrl": "https://api.pasarela.example",
    "ClientId": "clinica-demo",
    "ClientSecret": "",
    "MaxReintentos": 2
  },
  "RestSettings": {
    "EnableRequestLogs": false
  }
}
